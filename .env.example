# scripts/setup-vm.sh generates both credentials ON THE VM; do not commit .env.
# Connected GitHub account found during setup. Override only for a different owner/org.
GH_OWNER=irumata
SITE_ADDRESS=mistraleton.duckdns.org
# Blank credentials intentionally cause Compose to refuse startup.
# For local use: bash scripts/init-local.sh (generates them securely).
DB_ADMIN_PASSWORD=
DB_PASSWORD=
# Deployed commit tag is selected by CI; latest is for an initial manual pull only.
IMAGE_TAG=latest
# Keep empty on the 945 MiB VM. Opt-in only: COMPOSE_PROFILES=jobs
COMPOSE_PROFILES=

# Colab website: mandatory HTTP Basic login. Use Colab Secrets in the notebook.
SENTINEL_WEB_USERNAME=safestral
SENTINEL_WEB_PASSWORD=
SENTINEL_PUBLIC_URL=https://safestral.dpdns.org

# Cloudflare-generated connector token for the named Colab tunnel.
CF_TUNNEL_TOKEN=
