# Generate real values with: python3 scripts/configure.py --domain YOURNAME.duckdns.org --email YOU@example.com
DOMAIN=YOURNAME.duckdns.org
ACME_EMAIL=YOU@example.com
POSTGRES_USER=hackathon
POSTGRES_DB=hackathon
POSTGRES_PASSWORD=GENERATE_ME
REDIS_PASSWORD=GENERATE_ME
ADMIN_API_KEY=GENERATE_ME
WEBHOOK_SECRET=GENERATE_ME
API_REPLICAS=1
WORKER_REPLICAS=1
JOB_TIMEOUT=1200
REDIS_MAXMEMORY=256mb
HTTP_BIND=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443
# Optional migration to external/private services (URL-encode password characters):
# DATABASE_URL=postgresql://user:password@private-db:5432/hackathon?sslmode=require
# REDIS_URL=rediss://:password@private-redis:6379/0
